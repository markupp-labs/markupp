# Copie para .env ao lado do docker-compose.yaml e ajuste antes da primeira subida.

# Versão das imagens do GHCR, sem o v da tag de release.
MARKUPP_VERSION=1.0.0-rc.7

# Senha do PostgreSQL. Troque antes da primeira subida e use só letras e números,
# porque ela entra na URL do banco. O PostgreSQL não publica porta no host.
POSTGRES_PASSWORD=troque-esta-senha

# Chave que cifra o cookie de sessão do painel. Gere com: openssl rand -hex 64
SECRET_KEY_BASE=

# Endereços públicos da API e do painel. Atrás de um proxy com HTTPS, troque pelos
# domínios (https://markupp.exemplo.com, https://painel.markupp.exemplo.com).
MARKUPP_PUBLIC_URL=http://localhost:8080
MARKUPP_PANEL_URL=http://localhost:3000
# Portas publicadas no host.
MARKUPP_PORT=8080
WEB_PORT=3000

# O painel força HTTPS por padrão. Sem proxy com HTTPS na frente, como em localhost,
# deixe false; atrás de um proxy com HTTPS, troque para true.
MARKUPP_PANEL_FORCE_SSL=false

# Cadastro aberto de contas. Com false, só entra quem for convidado. Só ligue com SMTP:
# sem verificação de email, qualquer pessoa ocupa um email alheio.
MARKUPP_AUTH_REGISTRATION_ENABLED=false

# Email (convites, verificação de conta, troca de senha). Vazio, a instância roda
# sem email e o convite devolve o token para ser repassado à mão.
# Exemplo: smtps://usuario:senha@smtp.exemplo.com:465
MARKUPP_SMTP_URL=
MARKUPP_SMTP_FROM=
