# Copie para .env ao lado do docker-compose.yaml e ajuste antes da primeira subida.

# Versão das imagens do GHCR, sem o v da tag de release.
MARKUPP_VERSION=1.0.0-rc.7

# Senha do PostgreSQL. Troque antes da primeira subida e use só letras e números,
# porque ela entra na URL do banco. O PostgreSQL não publica porta no host.
POSTGRES_PASSWORD=troque-esta-senha

# Chave que cifra o cookie de sessão do painel. Gere com: openssl rand -hex 64
SECRET_KEY_BASE=

# Endereço público da instância: API, painel na raiz e MCP em /mcp. Atrás de um proxy
# com HTTPS, troque pelo domínio (https://markupp.exemplo.com).
MARKUPP_PUBLIC_URL=http://localhost:6275
# Só com o painel em subdomínio próprio (https://painel.markupp.exemplo.com).
MARKUPP_PANEL_URL=
# Porta publicada no host. Dentro do container o servidor segue na 6275.
MARKUPP_PORT=6275

# HTTPS forçado no painel, desligado por padrão no compose. Sem proxy com HTTPS na frente,
# como em localhost, deixe false; atrás de um proxy com HTTPS, troque para true.
MARKUPP_PANEL_FORCE_SSL=false

# Cadastro aberto de contas. Com false, só entra quem for convidado. Só ligue com SMTP:
# sem verificação de email, qualquer pessoa ocupa um email alheio.
MARKUPP_AUTH_REGISTRATION_ENABLED=false

# Email (convites, verificação de conta, troca de senha). Vazio, a instância roda
# sem email e o convite devolve o token para ser repassado à mão.
# Exemplo: smtps://usuario:senha@smtp.exemplo.com:465
MARKUPP_SMTP_URL=
MARKUPP_SMTP_FROM=

# Contas que administram a instância pelo painel, por email, separadas por vírgula.
# Só vale a conta com o email verificado. Vazio, ninguém administra pelo painel.
MARKUPP_INSTANCE_ADMINS=

# Chave que cifra os segredos guardados no banco, como a chave do provedor de
# embedding. Gere com: openssl rand -hex 32. Vazia, a chave fica no próprio banco, e
# quem tem uma cópia do banco também decifra os segredos. Não troque depois de usar.
MARKUPP_SECRET_KEY=

# Ligação por sentido: o indexador de embedding liga as notas que tratam do mesmo
# assunto. Vazio, vale o que o administrador da instância escolher no painel, sem
# provedor por padrão; definido, mesmo como none, trava a escolha do painel. local
# roda o modelo na própria máquina e baixa uns 300 MB (1,2 GB fora de x86 com AVX2);
# openai-compat pede os vetores a um endpoint /embeddings, com URL, modelo e chave.
# Trocar de provedor ou de modelo refaz os vetores de todas as notas.
MARKUPP_EMBEDDING_PROVIDER=
MARKUPP_EMBEDDING_URL=
MARKUPP_EMBEDDING_MODEL=
MARKUPP_EMBEDDING_API_KEY=
