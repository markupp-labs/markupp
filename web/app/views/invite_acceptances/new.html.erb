<% content_for :title, t(".title") %>

<h1 class="text-base font-semibold"><%= t(".title") %></h1>
<p class="mt-2 text-ink-muted"><%= t(".hint") %></p>

<%= render "token_forms/form", token_form: @form, scope: :invite_acceptance, url: invite_acceptance_path,
                               password: t(".password"), submit: t(".submit"), submitting: t(".submitting"),
                               base_link: (link_to t(".log_in"), new_session_path, class: "underline" if @form.errors.of_kind?(:base, :account_exists)) %>
