<%# General do cofre ativo: quem escreve renomeia e, na Danger zone, apaga; o viewer só lê o nome. %>
<% vault = current_vault %>
<div class="max-w-4xl">
  <%= render "settings/section_heading", title: t("settings.nav.vault_general"), subtitle: false %>

  <% if current_tenant.writer? %>
    <%= form_with scope: :vault, url: vault_path(vault.id), method: :patch, id: "vault_rename",
                  class: "mt-3 flex flex-col gap-3 md:flex-row md:items-end" do |form| %>
      <div class="md:flex-1">
        <%= form.label :name, t(".vault_name"), class: "block text-ink-muted" %>
        <%# O v r de qualquer página chega com focus=rename (ShortcutsHelper); aqui mesmo, o atalho foca o campo. %>
        <%= form.text_field :name, value: vault.name, required: true, maxlength: 100, autocomplete: "off", spellcheck: false,
                            autofocus: params[:focus] == "rename", data: { vault_action: "r" },
                            class: "w-full rounded-md border border-line bg-surface px-2 py-1" %>
      </div>
      <%= form.button t(".save"), class: "btn self-start md:self-auto" %>
    <% end %>

    <% if current_tenant.admin? %>
      <%# Publicar o cofre é de owner e admin; abre o diálogo de publicar do layout. O v o de qualquer página chega com
          focus=publish; aqui mesmo, o atalho abre o diálogo. %>
      <section id="vault_publication" aria-labelledby="vault_publication_title" class="mt-8">
        <h2 id="vault_publication_title" class="md-heading font-semibold"><%= t(".publication") %></h2>
        <p class="mt-1 max-w-[65ch] text-ink-muted"><%= t(".publication_hint") %></p>
        <%= link_to new_publication_path(kind: "vault"), id: "publish_vault", class: "btn mt-3", autofocus: params[:focus] == "publish",
                    data: { turbo_frame: "publish_preview", vault_action: "o" } do %>
          <%= icon("eye") %><%= t(".publish_vault") %>
        <% end %>
      </section>
    <% end %>

    <%= render "settings/danger_zone", id: "delete_vault", action: t(".delete_vault"), hint: t(".delete_hint"), name: vault.name,
                                       confirm: t(".confirm_delete", name: vault.name), path: vault_path(vault.id) %>
  <% else %>
    <dl id="vault_general" class="mt-3">
      <dt class="text-ink-muted"><%= t(".vault_name") %></dt>
      <dd class="[overflow-wrap:anywhere]"><%= vault.name %></dd>
    </dl>
  <% end %>
</div>
