<%# Recusas de ligação do cofre ativo, a mais nova primeiro: as duas notas, que abrem, a data e, para quem escreve, o
    desfazer. Grade no desktop, blocos empilhados no celular, e pelo teclado como as listas de membros: j/k entre as
    linhas, Delete na linha com o foco desfaz. %>
<div class="max-w-4xl">
  <%= render "settings/section_heading", title: t("settings.nav.link_refusals"), subtitle: current_vault.name %>
  <p class="mt-3 text-ink-muted"><%= t(".hint") %></p>

  <% if @refusal %>
    <p role="alert" class="mt-3 text-danger"><%= @refusal %></p>
  <% end %>

  <% if link_refusals.empty? %>
    <%= render "layouts/empty_state", title: t(".empty"), hint: t(".empty_hint") %>
  <% else %>
    <ul id="link_refusals" data-controller="context-menu" data-action="keydown->context-menu#navigate keydown->context-menu#deleteFocused"
        class="mt-4 md:grid md:grid-cols-[1fr_7rem_auto] md:gap-x-3">
      <li aria-hidden="true" class="hidden px-2 py-1 text-ink-muted md:col-span-3 md:grid md:grid-cols-subgrid">
        <span><%= t(".notes") %></span>
        <span><%= t(".refused") %></span>
      </li>
      <%= render partial: "settings/link_refusals/link_refusal", collection: link_refusals %>
    </ul>
  <% end %>
</div>
