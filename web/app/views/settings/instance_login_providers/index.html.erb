<%# Login externo da instância: um cartão por provedor, com o que ele é, o endereço de retorno para registrar no provedor
    e o formulário de edição; embaixo, o de criação, com os começos prontos do GitHub e do Google. Com a lista fixada por
    quem hospeda, os cartões ficam só para leitura e a criação some. %>
<% listing = @listing %>
<div class="max-w-[65ch]">
  <%= render "settings/section_heading", title: t("settings.nav.instance_login_providers"), subtitle: false %>
  <p class="mt-1 text-ink-muted"><%= t(".intro") %></p>

  <% if @refusal %>
    <p role="alert" class="mt-3 text-danger"><%= @refusal %></p>
  <% end %>
  <% if listing.locked %>
    <p id="login_providers_locked" class="mt-3"><%= t(".locked") %></p>
  <% end %>

  <% if listing.providers.empty? %>
    <p class="mt-4 text-ink-muted"><%= t(".empty") %></p>
  <% else %>
    <ul id="login_providers" class="mt-4 flex flex-col gap-4">
      <%= render partial: "provider", collection: listing.providers, locals: { listing_locked: listing.locked } %>
    </ul>
  <% end %>

  <% unless listing.locked %>
    <section id="new_login_provider" aria-labelledby="new_login_provider_title" class="mt-8">
      <h2 id="new_login_provider_title" class="md-heading font-semibold"><%= t(".new") %></h2>
      <p class="mt-1 text-ink-muted">
        <%= t(".presets") %>
        <% InstanceLoginProvider::PRESETS.each do |preset, fields| %>
          <%= link_to fields[:name], settings_instance_login_providers_path(preset:, anchor: "new_login_provider"), class: "underline" %>
        <% end %>
      </p>
      <%= form_with scope: :login_provider, url: settings_instance_login_providers_path, namespace: "new", class: "mt-3" do |form| %>
        <%= render "fields", form:, provider: @draft, new_record: true %>
        <%= form.button t(".create"), class: "btn mt-4" %>
      <% end %>
    </section>
  <% end %>
</div>
