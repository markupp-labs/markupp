<%# Tudo que está público no tenant, do cofre escolhido: o seletor vem com o ativo marcado (v p foca o seletor, e o Show
    troca a lista sem script). A lista anda como a de membros: j/k entre as linhas, Delete na linha com o foco despublica,
    com confirmação. %>
<div class="max-w-5xl">
  <%= render "settings/section_heading", title: t("settings.nav.publications") %>
  <p class="mt-2 max-w-[65ch] text-ink-muted"><%= t(".hint") %></p>

  <%= form_with url: settings_publications_path, method: :get, class: "mt-3 flex flex-col gap-2 md:flex-row md:items-end" do |form| %>
    <div class="md:flex-1">
      <%= form.label :vault_id, t(".vault"), class: "block text-ink-muted" %>
      <%= form.select :vault_id, [ [ t(".all_vaults"), Settings::PublicationsController::ALL_VAULTS ], *Array(current_vaults).map { [ it.name, it.id ] } ],
                      { selected: chosen_vault_id || Settings::PublicationsController::ALL_VAULTS }, data: { vault_action: "p" },
                      class: "w-full rounded-md border border-line bg-surface px-2 py-1" %>
    </div>
    <%= form.button t(".show"), name: nil, class: "btn self-start md:self-auto" %>
  <% end %>

  <% if tenant_publications.empty? %>
    <div class="mt-4"><%= render "layouts/empty_state", title: t(".empty.title"), hint: t(".empty.hint") %></div>
  <% else %>
    <ul id="publications" data-controller="context-menu" data-action="keydown->context-menu#navigate keydown->context-menu#deleteFocused"
        class="mt-4 md:grid md:grid-cols-[1fr_8rem_9rem_6rem_auto] md:gap-x-3">
      <li aria-hidden="true" class="hidden px-2 py-1 text-ink-muted md:col-span-5 md:grid md:grid-cols-subgrid">
        <span><%= t(".what") %></span>
        <span><%= t(".vault") %></span>
        <span><%= t(".who") %></span>
        <span><%= t(".when") %></span>
      </li>
      <%= render partial: "settings/publications/publication", collection: tenant_publications %>
    </ul>
  <% end %>
</div>
