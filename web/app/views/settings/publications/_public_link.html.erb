<%# O link público do cofre, para abrir ou copiar (copy_link_controller.js); o status diz se copiou. %>
<% link = public_vault_url(publication.slug) %>
<%= tag.div class: "mt-3 rounded-md border border-line p-2",
            data: { controller: "copy-link", copy_link_text_value: link, copy_link_copied_value: t(".copied"), copy_link_failed_value: t(".copy_failed") } do %>
  <p class="text-ink-muted"><%= t(".label") %></p>
  <div class="flex flex-wrap items-center gap-2">
    <%= link_to link, link, target: "_blank", rel: "noopener", class: "min-w-0 text-accent underline [overflow-wrap:anywhere]" %>
    <button type="button" class="btn" data-action="copy-link#copy"><%= icon("copy") %><%= t(".copy") %></button>
    <span role="status" aria-live="polite" data-copy-link-target="status" class="text-ink-muted"></span>
  </div>
<% end %>
