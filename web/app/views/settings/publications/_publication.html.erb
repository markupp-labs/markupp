<%# Uma publicação: o quê (a nota leva ao endereço público), quantas notas, o cofre, quem e quando, e a indexação. Os
    botões só para quem a API deixaria mudar. %>
<% name = publication.target_name %>
<li data-context-menu-target="item" tabindex="<%= publication_counter.zero? ? 0 : -1 %>"
    class="border-t border-line px-2 py-2 md:col-span-5 md:grid md:grid-cols-subgrid md:items-center">
  <div class="min-w-0">
    <p class="[overflow-wrap:anywhere]">
      <span class="text-ink-muted"><%= t(".kinds.#{publication.kind}") %></span>
      <%= publication.public_param ? link_to(name, public_note_path(publication.public_param), target: "_blank", rel: "noopener", class: "text-accent underline") : name %>
    </p>
    <p class="text-xs text-ink-muted">
      <%= t(".note_count", count: publication.note_count) %>,
      <%= publication.indexable ? t(".indexed") : t(".not_indexed") %>
    </p>
  </div>
  <p class="truncate text-ink-muted" title="<%= publication.vault_name %>"><%= publication.vault_name %></p>
  <p class="truncate"><span class="md:sr-only"><%= t("settings.publications.index.who") %></span> <%= publication.published_by_name %></p>
  <p class="text-ink-muted"><span class="md:sr-only"><%= t("settings.publications.index.when") %></span> <%= l(publication.published_at.to_date, format: :short) %></p>
  <div class="mt-1 flex flex-wrap gap-2 md:mt-0">
    <% if changes_publication?(publication) %>
      <%= form_with url: settings_publication_path(publication.id), method: :patch do %>
        <%= hidden_field_tag :vault_id, params[:vault_id], id: nil if params[:vault_id] %>
        <%= hidden_field_tag :indexable, !publication.indexable, id: nil %>
        <button type="submit" class="btn"><%= publication.indexable ? t(".hide") : t(".index") %></button>
      <% end %>
      <%= button_to t(".unpublish"), settings_publication_path(publication.id), method: :delete, params: { vault_id: params[:vault_id] }.compact,
                    class: "btn btn-danger",
                    data: { context_menu_delete: "", confirm_button: t(".unpublish"), turbo_confirm: t(".confirm_unpublish", name:, count: publication.note_count) } %>
    <% end %>
  </div>
</li>
