<%# Despublicar tira o link do ar na hora e libera o slug: confirma antes, pelo diálogo do painel. %>
<section class="mt-6 rounded-md border border-danger p-3">
  <h2 class="font-semibold text-danger"><%= t(".title") %></h2>
  <p class="mt-1 text-ink-muted"><%= t(".hint") %></p>
  <%= button_to t(".unpublish"), settings_publication_path, method: :delete, params: { vault_id: },
