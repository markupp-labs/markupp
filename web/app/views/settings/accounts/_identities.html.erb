<%# Contas conectadas: cada provedor do servidor com o botão de conectar ou, já vinculado, o de desconectar. %>
<h2 class="mt-6 text-base font-semibold"><%= t(".title") %></h2>
<p class="mt-2 text-ink-muted"><%= t(".hint") %></p>
<div class="mt-3 flex flex-wrap items-center gap-3">
  <% login_providers.each do |provider| %>
    <% linked = identities.find { it.provider == provider.id } %>
    <% if linked %>
      <%= button_to t(".disconnect", provider: provider.name), settings_identity_path(linked.id),
                    method: :delete, class: "btn" %>
    <% else %>
      <%= button_to t(".connect", provider: provider.name), external_login_path(provider.id),
                    params: { purpose: "link" }, class: "btn", form: { data: { turbo: false } } %>
    <% end %>
  <% end %>
</div>
