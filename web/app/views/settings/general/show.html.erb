<%# O nome é só leitura: a API não tem rota para renomear o tenant. A Danger zone fica no fim, só para o owner. %>
<div class="max-w-4xl">
  <%= render "settings/tenant_heading", title: t("settings.nav.general"), subtitle: false %>

  <dl id="tenant_general" class="mt-3">
    <dt class="text-ink-muted"><%= t(".tenant_name") %></dt>
    <dd class="[overflow-wrap:anywhere]"><%= current_tenant.name %></dd>
  </dl>

  <% if current_tenant.owner? %>
    <% name = current_tenant.name %>
    <%= render "settings/danger_zone", id: "delete_tenant", action: t(".delete_tenant"), hint: t(".delete_hint"), name:,
                                       confirm: t(".confirm_delete", name:), path: tenant_path(current_tenant.id) %>
  <% end %>
</div>
