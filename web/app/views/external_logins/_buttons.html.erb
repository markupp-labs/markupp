<%# Um botão por provedor externo do servidor; purpose diz se a volta entra (login) ou cria a conta (signup). %>
<% if login_providers.any? %>
  <div class="mt-3 flex flex-col gap-2">
    <% login_providers.each do |provider| %>
      <%= button_to t("external_logins.buttons.continue", provider: provider.name), external_login_path(provider.id),
                    params: { purpose: }, class: "btn", form: { data: { turbo: false } } %>
    <% end %>
  </div>
<% end %>
