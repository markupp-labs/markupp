<%# Convite recebido: os botões levam a frase do convite como descrição, para o leitor de tela saber qual aceita. %>
<% sentence_id = "my_invite_#{invite.id}" %>
<li class="px-2 py-1">
  <p id="<%= sentence_id %>" class="[overflow-wrap:anywhere]"><%= t(".join", tenant: invite.tenant_name, role: t("tenants.roles.#{invite.role}")) %></p>
  <p class="text-xs text-ink-muted"><%= t(".expires", date: l(invite.expires_at.to_date, format: :short)) %></p>
  <div class="mt-1 flex gap-2">
    <%= button_to t(".accept"), my_invite_path(invite.id), method: :patch, class: "btn px-2 py-0",
                  aria: { describedby: sentence_id }, data: { turbo_submits_with: t(".accepting") } %>
    <%= button_to t(".decline"), my_invite_path(invite.id), method: :delete, class: "btn px-2 py-0 text-ink-muted",
                  aria: { describedby: sentence_id }, data: { turbo_submits_with: t(".declining") } %>
  </div>
</li>
