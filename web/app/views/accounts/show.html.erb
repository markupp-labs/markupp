<% content_for :title, t(".title") %>
<%= render "accounts/sidebar" %>

<div class="max-w-[65ch]">
  <h1 class="text-base font-semibold"><%= t(".title") %></h1>
  <dl class="mt-3">
    <dt class="text-ink-muted"><%= t(".email") %></dt>
    <dd class="[overflow-wrap:anywhere]"><%= credential.account_email %></dd>
  </dl>

  <h2 class="mt-6 text-base font-semibold"><%= t(".confirmation") %></h2>
  <p class="mt-2 text-ink-muted"><%= t(".confirmation_hint") %></p>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <%= button_to t(".send"), email_verification_path, class: "btn", data: { turbo_submits_with: t(".sending") } %>
    <%= link_to t(".have_token"), new_email_confirmation_path, class: "text-accent underline" %>
  </div>
</div>
