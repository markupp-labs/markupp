<%# Árvore das notas publicadas, só links: abre as pastas da nota lida e marca a nota. %>
<% if tree.folders.empty? && tree.notes.empty? %>
  <p class="px-2 py-1 text-ink-muted"><%= t(".empty") %></p>
<% else %>
  <%= render "public_notes/folder", folder: tree, current:, open_folders: current&.folder_names || [] %>
<% end %>
