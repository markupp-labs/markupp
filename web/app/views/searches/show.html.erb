<%= turbo_frame_tag "search_results" do %>
  <% if @notes.any? %>
    <ul id="search_options" role="listbox" aria-label="<%= t("layouts.application.search_notes") %>" class="max-h-[50dvh] overflow-y-auto p-1">
      <% @notes.each_with_index do |note, index| %>
        <li>
          <%= link_to note_path(note), role: "option", aria: { selected: index.zero? },
                      data: { turbo_frame: "_top", search_target: "result" },
                      class: "tree-row flex items-baseline gap-2 aria-selected:bg-accent-soft aria-selected:text-accent" do %>
            <span class="shrink-0"><%= note.name %></span>
            <span class="truncate text-ink-muted"><%= note.folder_names.join("/") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif params[:q].present? %>
    <p class="px-3 py-2 text-ink-muted"><%= t(".empty") %></p>
  <% end %>
<% end %>
