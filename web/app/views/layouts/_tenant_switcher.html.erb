<%# O nome leva para a tela padrão; o seletor abre num popover nativo ancorado no cabeçalho (sem suporte a âncora, fica no canto). %>
<div id="current_tenant" class="mb-2 flex items-start gap-1 [anchor-name:--tenant-switcher]">
  <%= link_to root_path, class: "tree-row min-w-0 flex-1" do %>
    <span class="flex items-baseline gap-1">
      <span class="shrink-0 text-ink-muted">markupp</span>
      <span class="shrink-0 text-ink-muted">/</span>
      <span class="truncate" title="<%= current_tenant.name %>"><%= current_tenant.name %></span>
    </span>
    <span class="block text-xs text-ink-muted"><%= t("tenants.roles.#{current_tenant.role}") %></span>
  <% end %>
  <button type="button" popovertarget="tenant_switcher" aria-label="<%= t(".switch") %>" title="<%= t(".switch") %>" class="btn-icon mt-0.5">
    <%= icon("caret-up-down") %>
  </button>
</div>

<div id="tenant_switcher" popover
     class="m-0 w-64 rounded-md border border-line bg-surface-sunken p-1 text-ink [inset:auto] [position-anchor:--tenant-switcher] [position-area:bottom_span-right]">
  <ul class="space-y-px">
    <% current_tenants.each do |tenant| %>
      <li><%= render "tenants/choice", tenant: %></li>
    <% end %>
  </ul>
  <%# Preguiçoso: o popover fechado não aparece na tela, então a lista só carrega quando ele abre. %>
  <%= turbo_frame_tag "my_invites", src: my_invites_path, loading: :lazy, target: "_top" do %>
    <p class="mt-1 border-t border-line px-2 py-1 text-ink-muted"><%= t(".loading") %></p>
  <% end %>
  <div class="mt-1 border-t border-line pt-1">
    <%= link_to t(".new_tenant"), tenants_path, class: "tree-row block" %>
  </div>
</div>
