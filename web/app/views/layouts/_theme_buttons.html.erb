<%# Sem Turbo: ele troca só o body, e o tema mora no data-theme do html. %>
<% ThemesController::THEMES.each do |theme| %>
  <%= button_to t("layouts.application.#{theme}_theme"), theme_path, method: :patch, params: { theme: theme }, form_class: "theme-to-#{theme}",
        class: "btn text-ink-muted", form: { data: { turbo: false } } %>
<% end %>
