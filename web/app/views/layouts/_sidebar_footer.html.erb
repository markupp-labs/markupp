<%# Uma linha só, como a barra de status do VS Code: o email abre o menu da conta e à direita ficam só os ícones de tema e
    configurações. A engrenagem é a única entrada das configurações (Conta inclusive), então o menu só diz quem está logado,
    com o email inteiro que o rodapé corta, e oferece o sair, como o "Signed in as" do GitHub. O menu anda pelo teclado como
    o da árvore (context_menu_controller.js) e abre acima do email, ancorado no rodapé (sem suporte a âncora, fica no canto). %>
<% on_settings = request.path.start_with?("/settings/") %>
<% current_class = "aria-[current=page]:bg-accent-soft aria-[current=page]:text-ink" %>
<% settings_label = t(".settings") %>
<footer class="flex shrink-0 items-center gap-1 border-t border-line p-2 [anchor-name:--account-menu]">
  <button type="button" popovertarget="account_menu" aria-haspopup="menu" title="<%= credential.account_email %>"
          class="tree-row flex min-w-0 flex-1 items-center gap-2 text-left text-ink-muted">
    <%= icon("user-circle") %><span class="truncate"><%= credential.account_email %></span>
  </button>
  <%= render "layouts/theme_buttons" %>
  <%= link_to settings_path, title: t(".settings_shortcut", keys: shortcut_key(:settings)), aria: { label: settings_label, keyshortcuts: "Control+, Meta+,", current: ("page" if on_settings) },
              class: "btn-icon #{current_class}" do %>
    <%= icon("gear-six") %>
  <% end %>

  <%# O role=menu fica só em volta do item: pelo ARIA, menu só contém menuitem, group e separator. O "Signed in as" fica
      fora e descreve o menu (aria-describedby). %>
  <div id="account_menu" popover="manual" data-controller="context-menu"
       data-action="keydown->context-menu#navigate toggle->context-menu#returnFocus toggle->context-menu#focusFirst pointerdown@document->context-menu#closeOutside click@document->context-menu#rememberInvokerClick"
       class="layer m-0 mb-1 ml-2 w-64 origin-bottom-left layer-panel p-1 text-[13px] [inset:auto] [position-anchor:--account-menu] [position-area:top_span-right]">
    <p id="account_menu_signed_in" class="border-b border-line px-2 pb-1.5 pt-1 text-ink-muted">
      <%= t(".signed_in_as") %><br><span class="break-all text-ink"><%= credential.account_email %></span>
    </p>
    <div role="menu" tabindex="-1" aria-label="<%= t(".account_menu") %>" aria-describedby="account_menu_signed_in">
      <%= button_to t(".log_out"), session_path, method: :delete, role: "menuitem", tabindex: -1, class: "tree-row context-menu-item" %>
    </div>
  </div>
</footer>
