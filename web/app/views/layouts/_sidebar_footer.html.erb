<%# Conta e Settings levam às configurações unificadas; o email marca a seção Conta, o Settings as demais. %>
<% on_account = current_page?(settings_account_path) %>
<% current_class = "aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent" %>
<footer class="shrink-0 border-t border-line p-2">
  <%= link_to settings_account_path, aria: { current: ("page" if on_account) },
              class: "tree-row flex items-center gap-2 text-ink-muted #{current_class}" do %>
    <%= icon("user-circle") %>
    <span class="truncate" title="<%= credential.account_email %>"><%= credential.account_email %></span>
  <% end %>
  <div class="mt-1 flex flex-wrap items-center gap-1">
    <%= link_to settings_path, title: t(".settings_shortcut"), aria: { keyshortcuts: "Control+, Meta+,", current: ("page" if request.path.start_with?("/settings/") && !on_account) },
                class: "tree-row flex items-center gap-2 whitespace-nowrap text-ink-muted #{current_class}" do %>
      <%= icon("gear-six") %><%= t(".settings") %>
    <% end %>
    <span class="ml-auto flex items-center gap-1">
      <%= render "layouts/theme_buttons" %>
      <%= button_to session_path, method: :delete, class: "tree-row flex items-center gap-2 whitespace-nowrap text-ink-muted" do %>
        <%= icon("sign-out") %><%= t(".log_out") %>
      <% end %>
    </span>
  </div>
</footer>
