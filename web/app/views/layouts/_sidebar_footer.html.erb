<footer class="shrink-0 border-t border-line p-2">
  <%= link_to account_path, aria: { current: ("page" if current_page?(account_path)) },
              class: "tree-row flex items-center gap-2 text-ink-muted aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent" do %>
    <%= icon("user-circle") %>
    <span class="truncate" title="<%= credential.account_email %>"><%= credential.account_email %></span>
  <% end %>
  <div class="mt-1 flex items-center gap-1">
    <% if current_tenant&.admin? %>
      <%= link_to settings_path, class: "tree-row flex items-center gap-2 text-ink-muted" do %>
        <%= icon("gear-six") %><%= t(".settings") %>
      <% end %>
    <% end %>
    <span class="ml-auto flex items-center gap-1">
      <%= render "layouts/theme_buttons" %>
      <%= button_to session_path, method: :delete, class: "tree-row flex items-center gap-2 text-ink-muted" do %>
        <%= icon("sign-out") %><%= t(".log_out") %>
      <% end %>
    </span>
  </div>
</footer>
