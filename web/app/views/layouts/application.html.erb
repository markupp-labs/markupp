<!DOCTYPE html>
<% html_attributes = sidebar_html_attributes %>
<%= tag.html lang: "en", style: html_attributes[:style],
             data: { theme: chosen_theme, **html_attributes[:data] } do %>
  <%= render "layouts/head" %>

  <%# Sem tenant ativo (onboarding) não há notas para buscar: sem busca, sem seletor. %>
  <%# Ctrl+B/Cmd+B recolhe a barra lateral como no VS Code; o grid e o fechado vêm do CSS (.app-shell). %>
  <%# Ctrl+, e Cmd+, abrem as configurações; o Stimulus não tem filtro para a vírgula, o controller confere a tecla. %>
  <% shortcuts = "keydown.ctrl+b@window->sidebar#toggleFromShortcut keydown.meta+b@window->sidebar#toggleFromShortcut keydown@window->settings-shortcut#open" %>
  <% shortcuts += " keydown.ctrl+k@window->search#open:prevent keydown.meta+k@window->search#open:prevent" if current_tenant %>
  <body class="app-shell min-h-dvh bg-surface font-mono text-sm text-ink"
        <%= tag.attributes(data: { controller: [ "sidebar", "settings-shortcut", ("search" if current_tenant) ].compact.join(" "), action: shortcuts,
                                  settings_shortcut_url_value: settings_path }) %>>
    <%# Cada página nomeia a barra lateral pelo que ela mostra ali; sem nome, são as notas. %>
    <% sidebar_label = content_for(:sidebar_label).presence || t(".notes") %>
    <button popovertarget="sidebar" class="btn m-2 text-ink-muted md:hidden">
      <%= icon("list") %><%= sidebar_label %>
    </button>

    <%# A lista rola dentro de .sidebar-scroll; o rodape com conta, configuracoes, tema e sair fica sempre no fundo. %>
    <nav id="sidebar" popover aria-label="<%= sidebar_label %>"
         data-sidebar-target="panel"
         class="sidebar m-0 h-dvh w-72 max-w-[85vw] flex-col border-0 border-r border-line bg-surface-sunken p-0 text-ink open:flex md:w-auto md:max-w-none">
      <div class="sidebar-scroll min-h-0 flex-1 overflow-y-auto p-3">
        <%= sidebar_toggle_button(t(".hide_sidebar"), classes: "float-right ml-1 hidden md:inline-flex") %>
        <% if current_tenant %>
          <%= render "layouts/tenant_switcher" %>
          <button type="button" data-action="search#open" title="Ctrl+K" aria-keyshortcuts="Control+K Meta+K"
                  class="tree-row mb-2 flex w-full items-center gap-2 border border-line text-left text-ink-muted">
            <%= icon("magnifying-glass") %><%= t(".search") %>
            <kbd aria-hidden="true" class="ml-auto text-xs">Ctrl K</kbd>
          </button>
        <% end %>
        <%= yield :sidebar %>
      </div>

      <%= render "layouts/sidebar_footer" %>

      <%# Alça na borda: arrastar com o ponteiro ou setas com o foco. Só no desktop; no celular é gaveta. %>
      <div role="separator" aria-orientation="vertical" tabindex="0" aria-label="<%= t(".resize_sidebar") %>"
           aria-valuemin="<%= SidebarHelper::SIDEBAR_WIDTH_RANGE.min %>" aria-valuemax="<%= SidebarHelper::SIDEBAR_WIDTH_RANGE.max %>"
           aria-valuenow="<%= current_sidebar_width %>"
           data-sidebar-target="handle"
           data-action="pointerdown->sidebar#startResize pointermove->sidebar#resize pointerup->sidebar#endResize pointercancel->sidebar#endResize keydown->sidebar#resizeByKey"
           class="sidebar-handle absolute inset-y-0 right-0 hidden w-1.5 cursor-col-resize touch-none md:block"></div>
    </nav>

    <% if current_tenant %>
      <dialog data-search-target="dialog" aria-label="<%= t(".search_notes") %>"
              class="mx-auto mt-[15vh] w-[min(36rem,calc(100vw-2rem))] rounded-md border border-line bg-surface text-ink backdrop:bg-surface-sunken/70">
        <%= form_with url: search_path, method: :get, data: { turbo_frame: "search_results", search_target: "form" } do |form| %>
          <%= form.search_field :q, placeholder: t(".search_placeholder"), autocomplete: "off", role: "combobox",
                                aria: { label: t(".search_notes"), controls: "search_options", expanded: true },
                                data: { search_target: "input",
                                        action: "input->search#submit keydown.down->search#next:prevent keydown.up->search#previous:prevent keydown.enter->search#choose" },
                                class: "w-full border-0 border-b border-line bg-transparent px-3 py-2 outline-none" %>
        <% end %>
        <%= turbo_frame_tag "search_results" %>
      </dialog>
    <% end %>

    <main class="min-w-0 p-4 md:p-6">
      <%= sidebar_toggle_button(t(".show_sidebar"), classes: "sidebar-expand mb-2") %>
      <%= render "layouts/flash" %>
      <% page = content_for?(:main) ? yield(:main) : yield %>
      <%# Páginas de erro pedem o mascote ao lado da mensagem (content_for :mascot). %>
      <% if content_for?(:mascot) %>
        <div class="flex items-start gap-10"><%= yield :mascot %><div class="min-w-0 flex-1"><%= page %></div></div>
      <% else %>
        <%= page %>
      <% end %>
    </main>
  </body>
<% end %>
