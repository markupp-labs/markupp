<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "markupp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="markupp">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-surface font-mono text-sm text-ink md:grid md:grid-cols-[17rem_1fr]">
    <button popovertarget="sidebar" class="m-2 rounded-md border border-line px-3 py-1.5 text-ink-muted md:hidden">
      <%= t(".open_notes") %>
    </button>

    <nav id="sidebar" popover aria-label="<%= t(".notes") %>"
         class="sidebar m-0 h-dvh w-72 max-w-[85vw] overflow-y-auto border-0 border-r border-line bg-surface-sunken p-3 text-ink">
      <%= yield :sidebar %>
    </nav>

    <main class="min-w-0 p-4 md:p-6">
      <%= yield %>
    </main>
  </body>
</html>
