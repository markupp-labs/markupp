<!DOCTYPE html>
<%= tag.html lang: "en", data: { theme: cookies[:theme].presence_in(ThemesController::THEMES) } do %>
  <%= render "layouts/head" %>

  <%# Sem tenant ativo (onboarding) não há notas para buscar: sem busca, sem seletor. %>
  <body class="min-h-dvh bg-surface font-mono text-sm text-ink md:grid md:grid-cols-[17rem_1fr]"
        <%= tag.attributes(data: { controller: "search", action: "keydown.ctrl+k@window->search#open:prevent keydown.meta+k@window->search#open:prevent" }) if current_tenant %>>
    <button popovertarget="sidebar" class="btn m-2 text-ink-muted md:hidden">
      <%= t(".open_notes") %>
    </button>

    <nav id="sidebar" popover aria-label="<%= t(".notes") %>"
         class="sidebar m-0 h-dvh w-72 max-w-[85vw] overflow-y-auto border-0 border-r border-line bg-surface-sunken p-3 text-ink">
      <% if current_tenant %>
        <%= render "layouts/tenant_switcher" %>
        <button type="button" data-action="search#open" title="Ctrl+K" aria-keyshortcuts="Control+K Meta+K"
                class="tree-row mb-2 w-full border border-line text-left text-ink-muted">
          <%= t(".search") %>
        </button>
      <% end %>
      <%= yield :sidebar %>

      <footer class="mt-4 border-t border-line pt-3">
        <p class="truncate px-2 py-1 text-ink-muted"><%= credential.account_email %></p>
        <div class="mt-1 flex flex-wrap gap-2">
          <%= button_to t(".log_out"), session_path, method: :delete, class: "btn text-ink-muted" %>
          <%= render "layouts/theme_buttons" %>
        </div>
      </footer>
    </nav>

    <% if current_tenant %>
      <dialog data-search-target="dialog" aria-label="<%= t(".search_notes") %>"
              class="mx-auto mt-[15vh] w-[min(36rem,calc(100vw-2rem))] rounded-md border border-line bg-surface text-ink backdrop:bg-surface-sunken/70">
        <%= form_with url: search_path, method: :get, data: { turbo_frame: "search_results", search_target: "form" } do |form| %>
          <%= form.search_field :q, placeholder: t(".search_placeholder"), autocomplete: "off", role: "combobox",
                                aria: { label: t(".search_notes"), controls: "search_options", expanded: true },
                                data: { search_target: "input",
                                        action: "input->search#submit keydown.down->search#next:prevent keydown.up->search#previous:prevent keydown.enter->search#choose" },
                                class: "w-full border-0 border-b border-line bg-transparent px-3 py-2 outline-none" %>
        <% end %>
        <%= turbo_frame_tag "search_results" %>
      </dialog>
    <% end %>

    <main class="min-w-0 p-4 md:p-6">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
<% end %>
