<!DOCTYPE html>
<% html_attributes = sidebar_html_attributes %>
<%= tag.html lang: "en", style: html_attributes[:style],
             data: { theme: chosen_theme, editor_style: chosen_editor_style, **html_attributes[:data] } do %>
  <%= render "layouts/head" %>

  <%# Sem tenant ativo (onboarding) não há notas para buscar: sem busca, sem seletor. %>
  <%# Ctrl+B/Cmd+B recolhe a barra lateral como no VS Code; o grid e o fechado vêm do CSS (.app-shell). %>
  <%# Ctrl+, e Cmd+, abrem as configurações; o Stimulus não tem filtro para a vírgula, o controller confere a tecla. %>
  <%# Ctrl+Shift+E e Cmd+Shift+E levam o foco à árvore de notas (sidebar_controller.js); g e depois t abre a lista de tenants. %>
  <% shortcuts = "keydown.ctrl+b@window->sidebar#toggleFromShortcut keydown.meta+b@window->sidebar#toggleFromShortcut keydown@window->settings-shortcut#open keydown@window->sidebar#focusTree keydown@window->tenants-shortcut#open turbo:before-render@document->area-transition#mark" %>
  <% shortcuts += " keydown.ctrl+k@window->search#open:prevent keydown.meta+k@window->search#open:prevent" if current_tenant %>
  <body class="app-shell min-h-dvh bg-surface font-mono text-sm text-ink"
        <%= tag.attributes(data: { controller: [ "sidebar", "settings-shortcut", "tenants-shortcut", "area-transition", ("search" if current_tenant) ].compact.join(" "), action: shortcuts,
                                  area: content_for(:area).presence || "notes",
                                  settings_shortcut_url_value: settings_path, tenants_shortcut_url_value: tenants_path,
                                  sidebar_hide_label_value: t(".hide_sidebar"), sidebar_show_label_value: t(".show_sidebar") }) %>>
    <%= busy_origin_spinner_template %>
    <%# Cada página nomeia a barra lateral pelo que ela mostra ali; sem nome, são as notas. %>
    <% sidebar_label = content_for(:sidebar_label).presence || t(".notes") %>
    <button popovertarget="sidebar" class="btn m-2 text-ink-muted md:hidden">
      <%= icon("list") %><%= sidebar_label %>
    </button>

    <%# A lista rola dentro de .sidebar-scroll; o rodape com conta, configuracoes, tema e sair fica sempre no fundo. %>
    <nav id="sidebar" popover aria-label="<%= sidebar_label %>"
         data-sidebar-target="panel"
         class="sidebar layer m-0 h-dvh w-72 max-w-[85vw] flex-col border-0 border-r border-line bg-surface-sunken p-0 text-ink open:flex md:max-w-none">
      <div class="sidebar-scroll min-h-0 flex-1 overflow-y-auto p-3">
        <% if current_tenant %>
          <%= render "layouts/tenant_switcher" %>
          <button type="button" data-action="search#open" title="<%= shortcut_key(:search) %>" aria-keyshortcuts="Control+K Meta+K"
                  class="tree-row mb-2 flex w-full items-center gap-2 border border-line text-left text-ink-muted">
            <%= icon("magnifying-glass") %><%= t(".search") %>
            <kbd aria-hidden="true" class="ml-auto hidden text-xs md:inline"><%= shortcut_label(shortcut_key(:search)) %></kbd>
          </button>
        <% else %>
          <%# Sem tenant (onboarding, ou a API caiu antes de carregá-lo) a marca fica, com o nome do produto no lugar. %>
          <%= link_to root_path, class: "tree-row mb-2 flex items-center gap-2" do %>
            <%= mascot(:small) %><span>markupp</span>
          <% end %>
        <% end %>
        <%= yield :sidebar %>
      </div>

      <%= render "layouts/sidebar_footer" %>

      <%# Alça na borda: arrastar com o ponteiro ou setas com o foco. Só no desktop; no celular é gaveta. %>
      <div role="separator" aria-orientation="vertical" tabindex="0" aria-label="<%= t(".resize_sidebar") %>"
           aria-valuemin="<%= SidebarHelper::SIDEBAR_WIDTH_RANGE.min %>" aria-valuemax="<%= SidebarHelper::SIDEBAR_WIDTH_RANGE.max %>"
           aria-valuenow="<%= current_sidebar_width %>"
           data-sidebar-target="handle"
           data-action="pointerdown->sidebar#startResize pointermove->sidebar#resize pointerup->sidebar#endResize pointercancel->sidebar#endResize keydown->sidebar#resizeByKey"
           class="sidebar-handle absolute inset-y-0 right-0 hidden w-1.5 cursor-col-resize touch-none md:block"></div>
    </nav>

    <%# Lombada: aba colada na borda da barra, ponta dela quando fechada; um botão só nos dois estados. No celular a gaveta tem o seu. %>
    <%= sidebar_toggle_button(t(sidebar_closed? ? ".show_sidebar" : ".hide_sidebar")) %>

    <% if current_tenant %>
      <dialog data-search-target="dialog" aria-label="<%= t(".search_notes") %>"
              class="layer mx-auto mt-[15vh] w-[min(36rem,calc(100vw-2rem))] layer-panel">
        <%= form_with url: search_path, method: :get, class: "relative", data: { turbo_frame: "search_results", search_target: "form" } do |form| %>
          <%= form.search_field :q, placeholder: t(".search_placeholder"), autocomplete: "off", role: "combobox",
                                aria: { label: t(".search_notes"), controls: "search_options", expanded: true },
                                data: { search_target: "input",
                                        action: "input->search#submit keydown.down->search#next:prevent keydown.up->search#previous:prevent keydown.enter->search#choose" },
                                class: "w-full border-0 border-b border-line bg-transparent py-2 pr-8 pl-3 outline-none" %>
          <%= busy_spinner(busy_when: "#search_results[aria-busy]", class: "busy-spinner-quiet absolute inset-y-0 right-3") %>
        <% end %>
        <%= turbo_frame_tag "search_results" %>
      </dialog>
    <% end %>

    <%= render "layouts/command_palette" %>
    <%= render "layouts/shortcut_help" %>

    <%# @container: o lado a lado escolhe colunas ou pilha pela largura do main (application.css). md:pl-10 deixa a lombada (21px) fora do conteúdo.
        Com a nota, o main vira coluna e o form fica com o que sobra depois do aviso, sem rolar a página por ele. %>
    <main class="@container min-w-0 p-4 has-[>.note-form]:flex has-[>.note-form]:flex-col md:p-6 md:pl-10">
      <%= render "layouts/flash" %>
      <% page = content_for?(:main) ? yield(:main) : yield %>
      <%# Páginas de erro pedem o mascote ao lado da mensagem (content_for :mascot). %>
      <% if content_for?(:mascot) %>
        <div class="flex items-start gap-10"><%= yield :mascot %><div class="min-w-0 flex-1"><%= page %></div></div>
      <% else %>
        <%= page %>
      <% end %>
    </main>
  </body>
<% end %>
