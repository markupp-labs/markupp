<%# Ajuda de atalhos, como a saída de um --help: "?" fora de campo de texto abre (shortcut_help_controller.js), Esc ou
    clicar fora fecha. A lista vem do ShortcutsHelper, a mesma da paleta de comandos. %>
<dialog id="shortcut_help" aria-labelledby="shortcut_help_title" closedby="any" data-controller="shortcut-help"
        data-action="keydown@window->shortcut-help#openFromKey"
        class="layer mx-auto mt-[8vh] max-h-[84dvh] w-[min(52rem,calc(100vw-2rem))] overflow-y-auto rounded-md border border-line bg-surface-sunken p-4 text-[13px] text-ink backdrop:bg-surface-sunken/70">
  <header class="mb-4 flex items-center justify-between gap-4">
    <div class="flex items-baseline gap-2"><span aria-hidden="true" class="text-accent">$</span><h2 id="shortcut_help_title" class="font-semibold"><%= t("shortcuts.help.title") %></h2></div>
    <form method="dialog">
      <button class="btn-icon ascii-brackets" aria-label="<%= t("shortcuts.help.close") %>" title="<%= t("shortcuts.help.close") %>"><%= icon("x") %></button>
    </form>
  </header>
  <div class="gap-8 md:columns-2" style="--help-keys-width: <%= help_keys_width %>ch">
    <% help_shortcut_groups.each do |group, shortcuts| %>
      <section class="mb-5 break-inside-avoid">
        <h3 class="md-heading mb-1 font-semibold"><%= t("shortcuts.groups.#{group}") %></h3>
        <dl class="grid grid-cols-[var(--help-keys-width)_minmax(0,1fr)] gap-x-4">
          <% shortcuts.each do |shortcut| %>
            <dt class="whitespace-nowrap text-accent"><%= safe_join(shortcut.keys.map { tag.kbd(it) }, tag.span(" / ", class: "text-ink-muted")) %></dt>
            <dd class="text-ink-muted"><%= shortcut_name(shortcut) %></dd>
          <% end %>
        </dl>
      </section>
    <% end %>
  </div>
  <p class="text-ink-muted"><%= t("shortcuts.help.mac") %></p>
</dialog>
