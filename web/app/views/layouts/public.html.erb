<!DOCTYPE html>
<%= tag.html lang: "en", data: { theme: chosen_theme } do %>
  <%= render "layouts/head" %>

  <%# Telas sem sessão: o mascote à esquerda e o formulário numa coluna estreita, como o banner de um terminal. %>
  <%# No celular o mascote some e fica só a coluna. Os dois ficam no centro da tela em qualquer largura. %>
  <body class="grid min-h-dvh place-items-center bg-surface font-mono text-sm text-ink"
        data-area="public" data-controller="area-transition" data-action="turbo:before-render@document->area-transition#mark">
    <%= page_busy_spinner %>
    <main class="flex w-full max-w-3xl items-center justify-center gap-10 p-4 md:p-6">
      <%= mascot(:large, class: "hidden md:block") %>
      <div class="w-full max-w-sm">
        <p class="mb-4 text-ink-muted">markupp</p>
        <%= render "layouts/flash" %>
        <%= yield %>

        <footer class="mt-6 border-t border-line pt-3">
          <%= render "layouts/theme_buttons" %>
        </footer>
      </div>
    </main>
  </body>
<% end %>
