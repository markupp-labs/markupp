<%# Configurações como no VS Code e no Obsidian: navegação à esquerda, seção à direita; no celular a navegação vira uma linha acima,
    com o grupo Tenant numa linha própria para a General não parecer configuração do app. %>
<%# Com tenant a barra lateral é a das notas, árvore e New note; sem ele (onboarding) fica só a marca e o rodapé. %>
<% content_for :area, "settings" %>
<% if current_tenant %>
  <% content_for :sidebar, render("notes/sidebar", tree: sidebar_note_tree, current: nil) %>
<% else %>
  <% content_for :sidebar_label, t("settings.nav.title") %>
<% end %>
<% content_for :main do %>
  <div class="max-w-5xl">
    <div class="flex items-center gap-2 border-b border-line pb-2">
      <%= render "layouts/area_back" %>
      <p class="flex-1 font-semibold"><%= t("settings.nav.title") %></p>
      <%= link_to root_path, class: "btn-icon", aria: { label: t("settings.nav.close") }, title: t("settings.nav.close") do %>
        <%= icon("x") %>
      <% end %>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8">
      <nav aria-label="<%= t("settings.nav.title") %>" data-focus-region="settings" data-focus-region-target="[aria-current=page]; a" class="flex flex-wrap gap-1 md:flex-col md:flex-nowrap">
        <%= settings_nav_link("accounts", settings_account_path) %>
        <%= settings_nav_link("appearances", settings_appearance_path) %>
        <%= settings_nav_link("editors", settings_editor_path) %>
        <% if current_tenant %>
          <div class="min-w-0 basis-full px-2 pt-3 md:basis-auto">
            <p class="text-xs text-ink-muted"><%= t("settings.nav.tenant") %></p>
            <p class="truncate text-ink-muted" title="<%= current_tenant.name %>"><%= current_tenant.name %></p>
          </div>
          <%= settings_nav_link("general", settings_general_path) %>
        <% end %>
        <% if current_tenant&.admin? %>
          <%= settings_nav_link("members", settings_members_path) %>
          <%= settings_nav_link("invites", settings_invites_path) %>
        <% end %>
      </nav>

      <section class="min-w-0"><%= yield %></section>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
