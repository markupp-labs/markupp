<%# Voltar das áreas ao lado das notas (AsideArea): à página de onde a área foi aberta, pelo clique ou pelo Esc. %>
<%= link_to area_origin_path, class: "btn-icon", title: t(".title"),
            aria: { label: t(".label"), keyshortcuts: "Escape" },
            data: { controller: "area-back", action: "keydown.esc@window->area-back#go" } do %>
  <%= icon("arrow-left") %>
<% end %>
