<% heading = t(current_tenants.any? ? "tenants.index.choose" : "tenants.index.first") %>
<% content_for :title, heading %>
<% content_for :sidebar_label, t("tenants.index.sidebar_label") %>

<div class="max-w-[65ch]">
  <h1 class="text-base font-semibold"><%= heading %></h1>
  <% if current_tenants.any? %>
    <ul class="mt-3 max-w-sm space-y-px">
      <% current_tenants.each do |tenant| %>
        <li><%= render "tenants/choice", tenant: %></li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-ink-muted"><%= t("tenants.index.first_hint") %></p>
  <% end %>

  <h2 class="mt-6 text-base font-semibold"><%= t("tenants.index.pending_invites") %></h2>
  <% if pending_invites.any? %>
    <ul class="mt-3 max-w-sm space-y-px rounded-md border border-line p-1">
      <%= render partial: "my_invites/invite", collection: pending_invites %>
    </ul>
  <% else %>
    <p class="mt-2 text-ink-muted">
      <%= t("tenants.index.no_invites") %>
      <%= link_to t("tenants.index.confirm_email"), settings_account_path, class: "text-accent underline" %>
    </p>
  <% end %>

  <h2 class="mt-6 text-base font-semibold"><%= t("tenants.index.new_tenant") %></h2>

  <%= form_with scope: :tenant, url: tenants_path, class: "mt-3 flex max-w-sm flex-col gap-3 rounded-md border border-line p-3" do |form| %>
    <div>
      <%= form.label :name, class: "block text-ink-muted" %>
      <%= form.text_field :name, value: @name, required: true, maxlength: 100, autocomplete: "off", autofocus: current_tenants.empty?,
                          aria: { invalid: @name_error.present?, describedby: ("tenant_name_error" if @name_error) },
                          class: "w-full rounded-md border border-line bg-surface px-2 py-1 aria-invalid:border-danger" %>
      <% if @name_error %>
        <p id="tenant_name_error" class="text-danger"><%= @name_error %></p>
      <% end %>
    </div>
    <%= form.button t("tenants.index.create"), class: "btn self-start", data: { turbo_submits_with: t("tenants.index.creating") } %>
  <% end %>
</div>
