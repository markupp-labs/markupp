<% content_for :title, t(".choose") %>

<div class="max-w-[65ch]">
  <h1 class="text-base font-semibold"><%= t(".choose") %></h1>
  <ul class="mt-3 space-y-px">
    <% current_tenants.each do |tenant| %>
      <li>
        <%= button_to current_tenant_path, method: :patch, params: { tenant_id: tenant.id },
                      aria: { current: (true if tenant.id == credential.tenant_id) },
                      class: "tree-row flex w-full items-baseline gap-2 text-left aria-[current=true]:bg-accent-soft aria-[current=true]:text-accent" do %>
          <span class="truncate"><%= tenant.name %></span>
          <span class="ml-auto shrink-0 text-ink-muted"><%= t("tenants.roles.#{tenant.role}") %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
