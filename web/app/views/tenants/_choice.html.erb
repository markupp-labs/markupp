<%# Ativa o tenant; o ativo leva o mesmo realce da nota atual. %>
<%= button_to current_tenant_path, method: :patch, params: { tenant_id: tenant.id },
              title: tenant.name, aria: { current: (true if tenant.id == credential.tenant_id) },
              class: "tree-row flex w-full items-baseline gap-2 text-left aria-[current=true]:bg-accent-soft aria-[current=true]:text-ink" do %>
  <span class="truncate"><%= tenant.name %></span>
  <span class="ml-auto shrink-0 text-ink-muted"><%= t("tenants.roles.#{tenant.role}") %></span>
<% end %>
