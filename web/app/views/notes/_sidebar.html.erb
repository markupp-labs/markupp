<%# Sem árvore (a listagem falhou nas configurações) fica só o aviso, sem New note. %>
<% if current_tenant.writer? && tree %>
  <%= link_to new_note_path(folder: current&.folder_names&.join("/").presence),
              class: "tree-row mb-2 flex items-center gap-2 border border-line" do %>
    <%= icon("file-plus") %><%= t(".new_note") %>
  <% end %>
<% end %>

<%# O aviso é curto; a página ao lado continua funcionando. %>
<% if tree.nil? %>
  <p class="px-2 py-1 text-danger"><%= t("notes.unreachable.title") %></p>
<% elsif tree.folders.empty? && tree.notes.empty? %>
  <p class="px-2 py-1 text-ink-muted"><%= t(".empty") %></p>
<% else %>
  <%# Ctrl+Shift+E (Cmd+Shift+E) traz o foco para cá de qualquer lugar, como o explorador do VS Code (sidebar_controller.js). %>
  <ul role="tree" aria-label="<%= t(".tree") %>" aria-keyshortcuts="Control+Shift+E Meta+Shift+E" class="note-tree"
      data-controller="note-tree" data-action="keydown->note-tree#navigate focusin->note-tree#roveToFocused">
    <%= render "notes/folder", folder: tree, path: "", guide: "", current:, open_folders: current&.folder_names || [] %>
  </ul>
<% end %>
