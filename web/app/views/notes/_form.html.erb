<% content_for :title, @note.name %>
<%# Sem cache do Turbo: voltar para a nota busca a versão atual, e o editor não é clonado no snapshot. %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% content_for :sidebar, render("notes/sidebar", tree: @tree, current: @note) %>

<%= form_with model: @note, class: "flex h-full flex-col gap-3",
              data: { controller: "editor note-form", note_form_leave_message_value: t(".leave"),
                      action: "keydown.ctrl+s@window->note-form#save:prevent keydown.meta+s@window->note-form#save:prevent " \
                              "input->note-form#track submit->note-form#allowLeaving " \
                              "beforeunload@window->note-form#warnBeforeUnload turbo:before-visit@document->note-form#confirmVisit" } do |form| %>
  <header class="flex items-center gap-3">
    <h1 class="min-w-0 flex-1 truncate text-ink-muted"><%= @note.path %></h1>
    <span data-note-form-target="unsaved" hidden class="text-ink-muted"><%= t(".unsaved") %></span>
    <%= form.button t(".save"), class: "rounded-md border border-line px-3 py-1 hover:bg-accent-soft" %>
  </header>

  <% if @conflict %>
    <div role="alert" data-note-form-target="conflict" class="flex flex-wrap items-center gap-3 rounded-md border border-danger p-2">
      <p class="flex-1 text-danger"><%= t(".conflict") %></p>
      <%= link_to t(".reload"), note_path(@note), data: { action: "note-form#allowLeaving" },
                  class: "rounded-md border border-line px-3 py-1 hover:bg-accent-soft" %>
      <%= form.button t(".overwrite"), name: "force", value: "true", class: "rounded-md border border-danger px-3 py-1 text-danger" %>
    </div>
  <% end %>

  <%= form.hidden_field :path %>
  <%= hidden_field_tag :last_modified_at, @note.updated_at&.iso8601(3), id: nil %>
  <%= form.text_area :content, data: { editor_target: "source", note_form_target: "source" }, aria: { label: @note.path },
                     class: "min-h-[60dvh] w-full flex-1 rounded-md border border-line bg-surface p-2" %>
<% end %>
