<%# Menu de contexto da árvore, à moda do VS Code: o note_tree_controller.js guarda a linha e esconde o que só vale para
    nota (data-note-only); o context_menu_controller.js abre no ponto, anda pelas setas e devolve o foco à linha.
    Quem só lê fica com os itens de copiar. %>
<div id="tree_menu" popover="manual" role="menu" tabindex="-1" aria-label="<%= t(".label") %>" data-controller="context-menu"
     data-action="keydown->context-menu#navigate toggle->context-menu#returnFocus pointerdown@document->context-menu#closeOutside"
     class="layer fixed m-0 w-64 layer-panel p-1 text-[13px] [inset:auto]">
  <% if writer %>
    <%= tree_menu_item(:new_here, shortcut: :new_note) %>
    <%= tree_menu_item(:rename, note_only: true) %>
    <%# Apagar pede confirmação antes (data-turbo-confirm do form, com o caminho da linha), com o texto do Delete da nota. %>
    <%= tree_menu_item(:delete, note_only: true, danger: true, type: "submit", form: "tree_delete_note") %>
  <% end %>
  <%= tree_menu_item(:copy_path) %>
  <%= tree_menu_item(:copy_wikilink, note_only: true) %>
</div>
<% if writer %>
  <%# O destino e a pergunta são da nota da linha: o note_tree_controller.js põe o action e o data-turbo-confirm antes de enviar. %>
  <%= form_with url: notes_path, method: :delete, id: "tree_delete_note", hidden: true,
                data: { note_tree_target: "deleteForm" } do %><% end %>
<% end %>
