<%# Ligações da nota aberta, como os painéis do Obsidian, em seções recolhíveis (details) com a contagem: quem liga para
    ela, para onde ela liga, quem cita o título dela sem ligar e as sugestões de ligação, cada item no partial da seção.
    j/k e setas andam pelas seções e linhas visíveis, Enter abre ou dobra (note_links_controller.js). %>
<%= turbo_frame_tag "note_links", target: "_top" do %>
  <% NoteLinkSection::NAMES.each do |name| %>
    <%= links_section(name, @sections[name]) do %>
      <%= render "note_links/page", section: name, items: @sections[name], offset: 0 %>
    <% end %>
  <% end %>
  <%# O aviso da recusa de ligação chega em data-message, e o controller o põe no status depois de o frame entrar: texto
      que já vem dentro da região viva não é lido. %>
  <%= tag.p role: "status", class: "truncate px-2 text-xs text-ink-muted", data: { note_links_target: "status", message: flash[:links_status] } %>
<% end %>
