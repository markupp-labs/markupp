{
  "name": "markupp-mcp",
  "version": "0.0.0",
  "description": "MCP server for markupp: lets AI agents read and write your markupp notes",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markupp",
    "notes",
    "knowledge-base",
    "ai-agents"
  ],
  "homepage": "https://github.com/markupp-labs/markupp/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/markupp-labs/markupp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markupp-labs/markupp.git",
    "directory": "mcp"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "markupp-mcp": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsc -p e2e && npm run build && vitest run --config e2e/vitest.config.ts",
    "test:pack": "tsc -p pack && vitest run --config pack/vitest.config.ts",
    "start": "node dist/bin.js http",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fastmcp": "^4.23.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "tldjs": false
  }
}
