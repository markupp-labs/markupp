# syntax=docker/dockerfile:1.7

# Imagem do indexador de embedding (ADR-0053): o mesmo servidor, compilado com cgo e
# a tag ORT para o provedor local rodar no ONNX Runtime. Fica no Debian porque o ONNX
# Runtime publicado é para glibc. Os pesos do modelo não vêm na imagem: o embed-loop
# baixa na primeira subida com o provedor local.
FROM golang:1.27-trixie AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -tags ORT -ldflags="-s -w" -o /out/markupp ./cmd/markupp

FROM debian:trixie-slim

# A versão do ONNX Runtime com que o hugot testa. Vem do pacote NuGet oficial da
# Microsoft, que traz a biblioteca das duas arquiteturas: o repositório do ONNX Runtime
# no GitHub, de onde vinham os tarballs, saiu do ar em 2026-11.
ARG ONNXRUNTIME_VERSION=1.31.1
ARG ONNXRUNTIME_NUPKG_SHA256=6871ccbc97f3d5bdb4095a1dcec33aa78d56f6ed8de5980ef5fa1d9f2e7c679a
ARG TARGETARCH

# O hugot procura a libonnxruntime.so em /usr/lib. A pasta do modelo nasce com o dono
# do servidor: um volume nomeado novo herda esse dono, e o servidor sem root grava nele.
RUN set -eux; \
  case "$TARGETARCH" in \
    amd64) arch=x64 ;; \
    arm64) arch=arm64 ;; \
    *) echo "arquitetura $TARGETARCH sem ONNX Runtime publicado, esperado amd64 ou arm64" >&2; exit 1 ;; \
  esac; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates curl unzip; \
  curl -fsSL -o /tmp/ort.nupkg "https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/${ONNXRUNTIME_VERSION}/microsoft.ml.onnxruntime.${ONNXRUNTIME_VERSION}.nupkg"; \
  echo "${ONNXRUNTIME_NUPKG_SHA256}  /tmp/ort.nupkg" | sha256sum -c -; \
  unzip -j /tmp/ort.nupkg "runtimes/linux-${arch}/native/libonnxruntime.so" -d /usr/lib/; \
  rm /tmp/ort.nupkg; \
  apt-get purge -y curl unzip; \
  apt-get autoremove -y; \
  rm -rf /var/lib/apt/lists/*; \
  useradd -u 10001 -m markupp; \
  install -d -o markupp -g markupp /var/lib/markupp/models
COPY --from=builder /out/markupp /usr/local/bin/markupp
USER markupp
ENTRYPOINT ["/usr/local/bin/markupp"]
CMD ["embed-loop"]
